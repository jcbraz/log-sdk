{
  "name": "opendata-log",
  "version": "0.1.0",
  "description": "Typed, dependency-free client and producer/consumer streams for self-hosted OpenData Log",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "José Braz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcbraz/log-sdk.git",
    "directory": "packages/log-sdk"
  },
  "bugs": {
    "url": "https://github.com/jcbraz/log-sdk/issues"
  },
  "keywords": [
    "opendata",
    "log",
    "events",
    "sdk",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p scripts/lint",
    "test": "bun test test/client.test.ts test/protocol.test.ts test/codecs.test.ts test/stream.test.ts scripts/lint",
    "lint": "bun run lint:format && bun run lint:biome && bun run lint:rules && bun run lint:contracts",
    "lint:format": "prettier --check src test scripts examples *.json .oxlintrc.json *.ts README.md",
    "lint:biome": "biome check --error-on-warnings .",
    "lint:rules": "bun scripts/lint/check.ts && bun scripts/lint/comments/no-lint-bypass.ts",
    "lint:contracts": "bun scripts/lint/typescript-audit.ts",
    "test:integration": "bun test test/integration.test.ts --timeout 20000",
    "check:package": "publint && node scripts/check-package.mjs",
    "prepublishOnly": "bun run build && bun run typecheck && bun run test && bun run check:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.2.0",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.4",
    "oxlint": "1.86.0",
    "prettier": "3.8.1",
    "publint": "0.3.18",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
